{
  "mode": "enforce",
  "mainBranch": "main",
  "verify": "",
  "verifyFull": "",
  "protectedPaths": [
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    ".referee/scripts/**",
    ".referee/state/**",
    ".referee/config.json",
    "!**/.env.example",
    "!**/.env.sample",
    "!**/.env.template"
  ],
  "appendOnlyPaths": [
    "**/migrations/**",
    "**/alembic/versions/**"
  ],
  "secretPaths": [
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "!**/.env.example",
    "!**/.env.sample",
    "!**/.env.template"
  ],
  "reviewer": {
    "kind": "subagent",
    "agent": "independent-reviewer",
    "cli": "",
    "note": "Set kind to \"cli\" and cli to a command that reads a prompt on stdin to review with another model family (for example a Codex or Gemini CLI)."
  },
  "maxReviewRounds": 3,
  "fullSendHours": 6,
  "fullSendMerges": false,
  "stopGateTimeoutSec": 120,
  "stopGateMaxBlocks": 3
}
